      "type": "string",
      "source": "review.account_type",
      "sensitive": false
    },
    "nickname": {
      "type": "string",
      "source": "review.nickname",
      "sensitive": true
    },
    "review_verified": {
      "type": "boolean",
      "source": "checkpoint",
      "sensitive": false
    }
  },
  "outcome_rules": "northstar-v1",
