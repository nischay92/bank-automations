{
  "schema_version": "1.0",
  "name": "prepare_savings_subaccount",
  "version": "1.0.0",
  "provenance": "live_llm_discovery",
  "model": "gpt-4.1",
  "application": "northstar-training",
  "ui_version": "1.0",
  "effect": "prepare_only",
  "input_schema": {
