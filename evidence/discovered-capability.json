        "pattern": "^\\S(?:.*\\S)?$",
        "title": "Nickname",
        "type": "string"
      }
    },
    "required": [
      "member_id",
      "nickname"
    ],
    "title": "Inputs",
    "type": "object"
  },
  "outputs": {
